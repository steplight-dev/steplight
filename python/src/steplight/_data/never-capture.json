    "source": "(^|[^a-z0-9])(card|cc|cvv|cvc|csc|otp|pin|ssn|aadhaar|aadhar|pan|passcode|password|passwd|pwd|iban|secret|token|csrf)\\d{0,2}([^a-z0-9]|$)|cardnum|creditcard|ccnum|cvv2|cardno|panno|aadhaarno",
    "flags": "i"
  },
  "splitCamelCase": {
    "source": "([a-z0-9])([A-Z])",
    "flags": "g",
    "replacement": "$1_$2"
  },
