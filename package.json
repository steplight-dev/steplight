{
  "name": "steplight-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Replay and trace every step your AI agent takes.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "spec": "node scripts/generate-spec.mjs",
    "release:version": "node scripts/release-version.mjs",
    "format": "prettier --write .",
    "demo": "pnpm --filter @steplight/demo-agent demo",
    "view": "node packages/cli/dist/bin.js view"
  },
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
