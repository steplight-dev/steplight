{
  "name": "steplight",
  "version": "0.2.0",
  "description": "Flight recorder for AI agents that drive a browser: record, replay, and flag prompt injection and data exfiltration. SDK and CLI in one install.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "steplight": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@steplight/cli": "workspace:*",
    "@steplight/sdk": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "keywords": [
    "ai-agents",
    "browser-agents",
    "prompt-injection",
    "playwright",
    "security",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steplight-dev/steplight.git"
  },
  "homepage": "https://github.com/steplight-dev/steplight#readme",
  "bugs": {
    "url": "https://github.com/steplight-dev/steplight/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
