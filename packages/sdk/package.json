{
  "name": "@steplight/sdk",
  "version": "0.2.0",
  "description": "Record Playwright-driven AI agent runs with Steplight.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-page-scan.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@steplight/core": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steplight-dev/steplight.git"
  },
  "homepage": "https://github.com/steplight-dev/steplight#readme",
  "bugs": {
    "url": "https://github.com/steplight-dev/steplight/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
