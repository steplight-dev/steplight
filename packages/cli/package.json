{
  "name": "@steplight/cli",
  "version": "0.2.0",
  "description": "Steplight CLI: view and export recorded agent runs.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "steplight": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/checkApi.d.ts",
      "default": "./dist/checkApi.js"
    },
    "./bin": {
      "default": "./dist/bin.js"
    }
  },
  "files": [
    "dist",
    "viewer-dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepack": "node scripts/copy-viewer.mjs"
  },
  "dependencies": {
    "@steplight/core": "workspace:*",
    "@steplight/redteam": "workspace:*",
    "commander": "^12.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@steplight/demo-agent": "workspace:*",
    "@steplight/fixtures-site": "workspace:*",
    "@steplight/sdk": "workspace:*",
    "@steplight/viewer": "workspace:*",
    "playwright": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steplight-dev/steplight.git"
  },
  "homepage": "https://github.com/steplight-dev/steplight#readme",
  "bugs": {
    "url": "https://github.com/steplight-dev/steplight/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
