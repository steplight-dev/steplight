{
  "name": "@steplight/core",
  "version": "0.2.0",
  "description": "Steplight trace schema, detectors, redaction, storage and OpenTelemetry mapping.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./run-store": {
      "types": "./dist/storage/runStore.d.ts",
      "default": "./dist/storage/runStore.js"
    },
    "./analyze": {
      "types": "./dist/storage/analyzeStore.d.ts",
      "default": "./dist/storage/analyzeStore.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steplight-dev/steplight.git"
  },
  "homepage": "https://github.com/steplight-dev/steplight#readme",
  "bugs": {
    "url": "https://github.com/steplight-dev/steplight/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
